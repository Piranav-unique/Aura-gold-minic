# Frontend Production Environment Definitions
# To compile with these values: flutter build appbundle --release --dart-define-from-file=.env
ENV=prod
# No Razorpay keys here: checkout gets its key ID from the backend per order, and
# the admin payments screen reads Razorpay through the backend.
ADMIN_MOBILE_NUMBER=9943795005
API_BASE_URL=https://api.aurumgold.co.in/api/v1
